# личные настройки и прогресс — у каждого свои
config.json
save_data.json
capri.log

# скачиваемая модель распознавания речи
models/

# сборка Rust
target/
capri-rs/target/

# то, что рядом с бинарником кладёт WebView2, и библиотеки Vosk
# (сам capri.exe в репозитории лежит — его и запускают, поэтому не игнорируем)
*.dll
capri.exe.WebView2/

# кэши, которые программа создаёт сама
tts-cache/
cache/

# журналы и снимки экрана — они про эту машину, а не про проект
*.log
*.pdb
# только снимки из корня (в assets/ лежат спрайты, их терять нельзя)
/*.png
capri-rs/*.png
/_*.txt

# личное и разовые записи голоса
chat_history.json
*.wav
*.mp3
py-tts-*

# скрипт и текст для голоса Windows: программа пишет их сама рядом с собой
capri-tts.ps1
capri-tts-text.txt
capri-tts-out.wav
capri-tts-err.txt

# служебное
*.tmp
